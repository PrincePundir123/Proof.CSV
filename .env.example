# Local preview works without an API key or Docker. Execution never falls back to the host.
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
MODEL_PROVIDER=vultr
VULTR_SERVERLESS_INFERENCE_API_KEY=
# Choose a currently available coding-capable model from Vultr's model catalog.
VULTR_MODEL=
SANDBOX_IMAGE=proofcsv-sandbox:1
SANDBOX_TIMEOUT_SECONDS=20
MAX_CONCURRENT_JOBS=2
MAX_DAILY_MODEL_CALLS=100
DATA_TTL_MINUTES=60
# Enable only behind the supplied HTTPS reverse proxy.
COOKIE_SECURE=false
# Optional stronger installed Docker runtime, for example runsc (gVisor).
SANDBOX_RUNTIME=
# Local development only: set MODEL_PROVIDER=local and launch the local AI service.
LOCAL_MODEL_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=proofcsv-local
# Optional MODEL_TIMEOUT_SECONDS: defaults to 600 locally, 60 with Vultr.
# Windows can call Docker installed in an existing Ubuntu WSL distribution.
DOCKER_TRANSPORT=native
WSL_DISTRO=Ubuntu
WSL_USER=root
