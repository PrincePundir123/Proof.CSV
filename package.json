{
  "name": "proofcsv",
  "version": "1.0.0",
  "private": true,
  "description": "An evidence-first CSV agent with isolated execution on Vultr",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "test": "node --test test/*.test.js",
    "test:sandbox": "node --env-file-if-exists=.env --test test/docker.integration.js",
    "verify:local": "node scripts/verify-local.js",
    "check": "node scripts/check.js",
    "test:browser": "playwright test"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
